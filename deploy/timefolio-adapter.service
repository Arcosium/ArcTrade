# Local account adapter; the public ArcTrade website uses port 8997.
[Unit]
Description=ArcTrade Timefolio account adapter
After=network.target

[Service]
WorkingDirectory=/home/arcosium/projects/ArcTrade/integrations/timefolio
EnvironmentFile=/home/arcosium/vault/ArcTrade/arctrade.env
ExecStart=/usr/bin/python3.12 -m uvicorn web.gateway:app --host 127.0.0.1 --port 8620
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
