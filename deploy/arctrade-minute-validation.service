[Unit]
Description=ArcTrade all KR candidate minute conversion validation
After=network-online.target
[Service]
WorkingDirectory=/home/arcosium/projects/ArcTrade
ExecStart=/usr/bin/python3 -m autofolio.minute_validation
Environment=OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
CPUQuota=100%
MemoryMax=4G
Nice=15
Restart=on-failure
RestartSec=30
UMask=0077
[Install]
WantedBy=default.target
