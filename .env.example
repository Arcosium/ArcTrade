# Copy this file to .env and enter only the providers you use.
# Never commit .env. ArcTrade does not accept API keys from the browser.
LLM_PROVIDER=auto

OPENAI_API_KEY=""
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=""
GEMINI_MODEL=gemini-3.7-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional local OpenAI-compatible server
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=qwen3.6-35b-a3b-uncensored

# Timefolio credentials. Live orders are OFF unless explicitly enabled.
TIMEFOLIO_USERNAME=""
TIMEFOLIO_PASSWORD=""
AUTOFOLIO_LIVE_ORDERS=0
AUTOFOLIO_TIMEFOLIO_HEADLESS=1

# Optional OpenDART financial/event data
OPENDART_API_KEY=""
OPENDART_CORP_XML=""

# Runtime data stays outside the repository by default (~/.local/share/arctrade).
ARCTRADE_PRIVATE_DATA_DIR=""
ARCTRADE_DATA_DIR=""
ARCTRADE_MARKET_DATA_DIR=""
ARCTRADE_QUANT_CACHE_DIR=""

ARCTRADE_HOST=127.0.0.1
ARCTRADE_PORT=8620
AUTOFOLIO_ENABLED=1
AI_STRATEGY_REFRESH_SEC=300
